# ==============================================================
# AARIZO CommunityOS - Master Environment Configuration Template
# ==============================================================

# --------------------------------------------------------------
# 1. FRONTEND PUBLIC CONFIGURATION (Vite Client-Side)
# (Safe to expose to browser. Prefixed with VITE_)
# --------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSy_your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=aarizo-community.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aarizo-community
VITE_FIREBASE_STORAGE_BUCKET=aarizo-community.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_USE_FIREBASE_EMULATOR=false

# Razorpay PUBLIC Key ID only (Safe for browser checkout modal; NEVER put secret here)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Publicly hosted branding logo for Razorpay modal (MUST be https:// or left empty)
VITE_PUBLIC_LOGO_URL=

# Backend REST API URL
VITE_BACKEND_URL=http://localhost:5000

# --------------------------------------------------------------
# 2. BACKEND SECRETS (Express Server & PostgreSQL ONLY)
# ⚠️ NEVER expose these in frontend code or commit to source control!
# --------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL + Prisma)
# Matches Docker Compose configuration
DATABASE_URL=postgresql://aarizo_admin:aarizo_secure_password_2026@localhost:5432/aarizo_community?schema=public

# Authentication Signing Secret (HMAC-SHA256)
# - REQUIRED in production: Minimum 32 cryptographically random characters.
#   Generate with: openssl rand -hex 32
# - In development / test: Ephemeral secret generated per process if omitted.
AUTH_SECRET=

# Development Mock Authentication Guard:
# - Set to 'true' in development/test to allow local mock tokens (mock_token_<userId>).
# - Strictly ignored and prohibited when NODE_ENV=production.
ENABLE_DEV_MOCK_AUTH=false

# Firebase Admin (Backend Token Verification)
FIREBASE_PROJECT_ID=aarizo-community
# FIREBASE_SERVICE_ACCOUNT_KEY=./service-account.json

# Razorpay Server-Side Credentials (NEVER expose to browser/mobile)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key_never_share
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret_never_share
