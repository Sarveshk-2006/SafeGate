# ==============================================================
# AARIZO Express & PostgreSQL Backend - Environment Variables
# ==============================================================
# ⚠️ SECRETS ONLY: Never expose to browser, mobile, or Git.

# --------------------------------------------------------------
# 1. CORE SERVER & RUNTIME
# --------------------------------------------------------------
PORT=5000
NODE_ENV=development

# --------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# --------------------------------------------------------------
# Local Docker or Native PostgreSQL:
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://aarizo_admin:aarizo_secure_password_2026@localhost:5432/aarizo_community?schema=public

# --------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# --------------------------------------------------------------
# Cryptographic secret for signing authoritative Bearer tokens (HMAC-SHA256).
# - REQUIRED in production: Minimum 32 cryptographically random characters.
#   Generate with: openssl rand -hex 32
# - In development / test: If omitted, an ephemeral random secret is generated per process.
AUTH_SECRET=

# Development Mock Authentication Guard:
# - Set to 'true' in development/test to allow local mock tokens (mock_token_<userId>).
# - Strictly ignored and prohibited when NODE_ENV=production.
ENABLE_DEV_MOCK_AUTH=false

# --------------------------------------------------------------
# 4. FIREBASE ADMIN CONFIGURATION (Phone OTP & Identity Verification)
# --------------------------------------------------------------
# Project ID (matches Firebase console):
FIREBASE_PROJECT_ID=aarizo-community
# Path to service account JSON file, or inline JSON string (optional for emulator):
# FIREBASE_SERVICE_ACCOUNT_KEY=./service-account.json

# --------------------------------------------------------------
# 5. PAYMENT GATEWAY SECRETS (Razorpay Server-Side)
# --------------------------------------------------------------
# Server-side only: Used for HMAC-SHA256 signature verification and order creation
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key_never_share
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret_never_share
